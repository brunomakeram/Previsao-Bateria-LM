# Importa as bibliotecas
import numpy as np 
import tensorflow as tf

# ==================================================================================================== #

# Etapa 1 Dados: Juntar exemplos com a resposta certa
medicoes_viagens = np.array([
    [0, 1],
    [5, 1],
    [5, 3],
    [10, 2]], dtype=np.float32)

gasto_viagens = np.array([
    [8],
    [11],
    [30],
    [27]], dtype=np.float32)

# Etapa 2 Preparo: Converte as listas para arrays np com float32, que é o tipo que o TensorFlow entende.

# ==================================================================================================== #

# Etapa 3 Criar o modelo: Duas entradas "(Input/shape=(2,))," e uma camada "Dense" com 1 neurônio.
modelo = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(2,)),
    tf.keras.layers.Dense(1)
])

# ==================================================================================================== #

# Etapa 4 Compilar o modelo: Escolher o otimizador e a função de perda.
modelo.compile(optimizer=tf.keras.optimizers.Adam(0.05), loss="mse")

# ==================================================================================================== #

# Etapa 5 Treinar o modelo: Ajustar a regra pra errar menos, repetindo por 1350 epochs (passadas) sobre os dados, verbose=0 pra não mostrar o progresso na tela.
modelo.fit(medicoes_viagens, gasto_viagens, epochs=1450, verbose=0)

# ==================================================================================================== #

# Etapa 6 Usar o modelo: Prever o gasto de bateria pra uma nova viagem, com 7 kg de carga e 2.5 km de distância.
nova_viagem = np.array([[7, 2.5]], dtype=np.float32)

# Prever o gasto de bateria usando o modelo treinado, numpy() converte o tensor de saída em array NumPy, permitindo usar [0][0] sem alterar o restante
gasto_previsto = modelo(nova_viagem, training=False).numpy()

# Pegar os pesos e vieses da camada final do modelo, que são os parâmetros aprendidos durante o treinamento.
pesos, vies = modelo.layers[-1].get_weights()

# ==================================================================================================== #

# Etapa 7 Mostrar os resultados: Imprimir os pesos, vieses e o gasto previsto.
# esperado: perto de 0.99
print("a (carga):", pesos[0][0])

# esperado: perto de 9.11
print("b (distância):", pesos[1][0])

# esperado: perto de -1.89
print("c (viés):", vies[0])

# esperado: perto de 27.8
print("Gasto previsto:", gasto_previsto[0][0])
